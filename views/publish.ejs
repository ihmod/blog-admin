<%- include('partials/header', { title: '发布', user, csrfToken }) %>
<%- include('partials/notice', { notice, error }) %>
<h1>发布</h1>
<section class="card">
  <p>状态：
    <% if (state.status === 'running') { %>
      <span class="badge draft">发布中</span>
    <% } else if (state.status === 'success') { %>
      <span class="badge">成功</span>
    <% } else if (state.status === 'error') { %>
      <span class="badge trash">失败</span>
    <% } else { %>
      <span class="badge">空闲</span>
    <% } %>
  </p>
  <% if (state.message) { %><p class="error"><%= state.message %></p><% } %>
  <% if (state.commitSha) { %>
    <p class="muted">最近提交：<code><%= state.commitSha.slice(0, 12) %></code></p>
  <% } %>
  <% if (state.finishedAt) { %>
    <p class="muted">完成时间：<%= state.finishedAt %></p>
  <% } %>
  <form method="post" action="/publish" id="publish-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" <%= state.status === 'running' ? 'disabled' : '' %>>发布到 GitHub</button>
  </form>
  <div class="publish-live" id="publish-live" hidden>
    <p class="publish-live-status" id="publish-live-status">正在启动发布…</p>
    <pre class="publish-log" id="publish-live-log"></pre>
  </div>
  <p class="muted">
    发布后由 GitHub Actions 构建并部署：
    <a href="https://github.com/ihmod/ihmod.github.io/actions" target="_blank" rel="noreferrer">
      https://github.com/ihmod/ihmod.github.io/actions
    </a>
  </p>
</section>

<section class="card">
  <h2>推送记录</h2>
  <% if (!runs || runs.length === 0) { %>
    <p class="muted">还没有发布记录。</p>
  <% } else { %>
    <div class="publish-runs">
      <% for (const run of runs) { %>
        <details class="publish-run">
          <summary>
            <% if (run.status === 'success') { %>
              <span class="badge">成功</span>
            <% } else if (run.status === 'error') { %>
              <span class="badge trash">失败</span>
            <% } else { %>
              <span class="badge draft">发布中</span>
            <% } %>
            <span class="mono"><%= run.startedAt %></span>
            <% if (run.commitSha) { %><code><%= run.commitSha.slice(0, 12) %></code><% } %>
            <% if (run.status === 'success') { %>
              <span class="muted"><%= run.posts %> 篇 / <%= run.files %> 文件<%= run.pushed ? ' · 已推送' : ' · 无新提交' %></span>
            <% } %>
            <% if (run.message) { %><span class="muted"><%= run.message %></span><% } %>
          </summary>
          <pre class="publish-log"><%= run.log %></pre>
        </details>
      <% } %>
    </div>
  <% } %>
</section>
<script src="/static/publish.js?<%= Date.now() %>"></script>
<%- include('partials/footer') %>
