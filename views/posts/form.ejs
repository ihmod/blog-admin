<%- include('../partials/header', { title: isNew ? '新建文章' : '编辑文章', user, csrfToken, vditor: true, wide: true }) %>
<%- include('../partials/notice', { notice: undefined, error: typeof error !== 'undefined' ? error : undefined }) %>

<form method="post" action="<%= isNew ? '/posts' : '/posts/' + post.id %>" id="post-form" class="editor-shell">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="editor-bar">
    <a class="editor-back" href="/posts">← 文章</a>
    <div class="editor-bar-center">
      <span class="editor-count" id="word-count">0 字</span>
      <span class="autosave-status" id="autosave-status">
        <span class="autosave-dot"></span>
        <span id="autosave-text"><%= isNew ? '保存后启用自动保存' : '自动保存已开启' %></span>
      </span>
    </div>
    <div class="editor-bar-view" role="group" aria-label="编辑视图">
      <button type="button" class="view-btn" id="toggle-side" aria-pressed="false">设置</button>
      <button type="button" class="view-btn" id="toggle-focus" aria-pressed="false">专注</button>
      <button type="button" class="view-btn" id="toggle-fullscreen" aria-pressed="false">全屏</button>
    </div>
    <div class="editor-bar-actions">
      <a class="btn-ghost" href="/posts">取消</a>
      <button class="btn-primary" type="submit">保存文章</button>
    </div>
  </div>

  <div class="editor-grid">
    <div class="editor-canvas">
      <div class="doc-tab">
        <span class="doc-status <%= post.status %>"><span class="doc-dot"></span><%= post.status === 'published' ? '已发布' : '草稿' %></span>
        <span class="doc-slug"><%= isNew ? 'untitled' : (post.slug || 'untitled') %></span>
      </div>

      <div class="editor-body">
        <label class="title-label" for="title">标题</label>
        <input id="title" name="title" class="title-input" value="<%= post.title %>" placeholder="写下一个标题..." required>

        <div class="editor-meta-line">
          <span class="mono"><%= isNew ? 'new post' : post.abbrlink %></span>
          <span class="dot-sep">·</span>
          <span><%= categories.find((c) => c.id === post.categoryId)?.name ?? '未分类' %></span>
          <span class="dot-sep">·</span>
          <span class="mono"><%= post.postDate %></span>
        </div>

        <input type="hidden" name="content_md" id="content_md" value="<%= post.contentMd %>">
        <div id="vditor" data-csrf="<%= csrfToken %>" data-post-id="<%= post.id ?? '' %>"></div>
      </div>
    </div>

    <aside class="editor-side">
      <section class="side-card">
        <h2 class="side-title">文章设置</h2>

        <div class="side-field">
          <label for="category_id">分类</label>
          <select id="category_id" name="category_id">
            <option value="">未分类</option>
            <% for (const category of categories) { %>
              <option value="<%= category.id %>" <%= post.categoryId === category.id ? 'selected' : '' %>><%= category.name %></option>
            <% } %>
          </select>
        </div>

        <div class="side-field">
          <label for="tag-input">标签</label>
          <input type="hidden" name="tags" id="tags" value="<%= post.tagsText ?? post.tags.join(', ') %>">
          <div class="tag-editor" id="tag-editor">
            <div class="tag-chips" id="tag-chips"></div>
            <input type="text" id="tag-input" placeholder="输入后回车" autocomplete="off">
          </div>
        </div>

        <div class="side-field">
          <label for="post_date">日期</label>
          <input id="post_date" name="post_date" class="mono" value="<%= post.postDate ?? '' %>" placeholder="YYYY-MM-DD HH:mm:ss">
        </div>

        <div class="side-field">
          <label for="slug">Slug</label>
          <input id="slug" name="slug" value="<%= post.slug ?? '' %>" placeholder="留空自动生成">
        </div>

        <div class="side-field">
          <label>发布状态</label>
          <div class="segmented" role="radiogroup" aria-label="发布状态">
            <label class="segment">
              <input type="radio" name="status" value="draft" <%= post.status === 'draft' ? 'checked' : '' %>>
              <span>草稿</span>
            </label>
            <label class="segment">
              <input type="radio" name="status" value="published" <%= post.status === 'published' ? 'checked' : '' %>>
              <span>已发布</span>
            </label>
          </div>
        </div>

        <div class="side-field">
          <label for="top_img">顶部图</label>
          <input id="top_img" name="top_img" value="<%= post.topImg ?? 'false' %>" placeholder="false 或图片 URL">
        </div>

        <div class="side-field">
          <label for="description">摘要</label>
          <textarea id="description" name="description" rows="3" placeholder="一句话介绍这篇文章"><%= post.description ?? '' %></textarea>
        </div>
      </section>

      <% if (!isNew && post.abbrlink) { %>
        <section class="side-card">
          <h2 class="side-title">链接</h2>
          <div class="permalink">
            <span class="mono">/posts/<%= post.abbrlink %>.html</span>
            <% if (post.status === 'published') { %>
              <a href="https://ihmod.github.io/posts/<%= post.abbrlink %>.html" target="_blank" rel="noreferrer">查看线上 →</a>
            <% } %>
          </div>
        </section>
      <% } %>

      <% if (!isNew) { %>
        <section class="side-card side-danger">
          <h2 class="side-title">危险操作</h2>
          <div class="danger-actions">
            <% if (post.status === 'published') { %>
              <button class="btn-danger-ghost" type="submit" form="unpublish-form">取消发布</button>
            <% } %>
            <button class="btn-danger-ghost" type="submit" form="delete-form">删除文章</button>
          </div>
        </section>
      <% } %>
    </aside>
  </div>
</form>

<% if (!isNew) { %>
  <form id="unpublish-form" method="post" action="/posts/<%= post.id %>/unpublish" hidden>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  </form>
  <form id="delete-form" method="post" action="/posts/<%= post.id %>/delete" hidden>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  </form>
<% } %>

<script src="/static/vditor/dist/index.min.js"></script>
<script src="/static/editor.js"></script>
<%- include('../partials/footer') %>
