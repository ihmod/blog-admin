<%- include('../partials/header', { title: isNew ? '新建文章' : '编辑文章', user, csrfToken, vditor: true, wide: true, editor: true }) %>
<%- include('../partials/notice', { notice: undefined, error: typeof error !== 'undefined' ? error : undefined }) %>

<form method="post" action="<%= isNew ? '/posts' : '/posts/' + post.id %>" id="post-form" class="editor-shell" data-status="<%= post.status %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="editor-bar">
    <div class="editor-bar-main">
    <a class="editor-back" href="/posts">← 文章</a>
    <div class="editor-bar-center">
      <span class="editor-count" id="word-count">0 字</span>
      <span class="autosave-status" id="autosave-status">
        <span class="autosave-dot"></span>
        <span id="autosave-text"><%= isNew ? '保存后启用自动保存' : '自动保存已开启' %></span>
      </span>
    </div>
    <div class="editor-bar-view" role="group" aria-label="编辑视图">
      <div class="editor-mode" role="group" aria-label="显示模式">
        <button type="button" class="mode-btn" data-mode="editor" aria-pressed="false">编辑</button>
        <button type="button" class="mode-btn" data-mode="both" aria-pressed="true">并排</button>
        <button type="button" class="mode-btn" data-mode="preview" aria-pressed="false">预览</button>
      </div>
      <button type="button" class="view-btn icon-btn" id="toggle-fullscreen" aria-pressed="false" aria-label="全屏" title="全屏">
        <svg class="icon-expand" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
          <path d="M8 3H3v5M17 8V3h-5M12 17h5v-5M3 12v5h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <svg class="icon-compress" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
          <path d="M3 8h5V3M17 12h-5v5M12 3v5h5M8 17v-5H3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <div class="editor-bar-actions">
      <a class="btn-ghost" href="/posts">取消</a>
      <button class="btn-primary" type="submit">保存文章</button>
    </div>
    </div>
  </div>

  <div class="editor-grid">
    <aside class="editor-left">
      <section class="side-card">
        <div class="side-head">
          <h2 class="side-title">文章</h2>
          <button type="button" class="side-toggle" id="toggle-left" aria-expanded="true" aria-label="收起文章列表" title="收起文章列表">
            <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
              <path d="M12.5 4.5l-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <input id="post-filter" class="side-search" type="search" placeholder="搜索文章..." autocomplete="off">
        <div class="post-filters">
          <select id="post-category-filter" aria-label="按分类筛选">
            <option value="">全部分类</option>
            <option value="未分类">未分类</option>
            <% for (const category of categories) { %>
              <option value="<%= category.name %>"><%= category.name %></option>
            <% } %>
          </select>
          <select id="post-tag-filter" aria-label="按标签筛选">
            <option value="">全部标签</option>
            <% for (const tag of tags) { %>
              <option value="<%= tag.name %>"><%= tag.name %></option>
            <% } %>
          </select>
        </div>
        <ul class="post-list" id="post-list">
          <% for (const item of recentPosts) { %>
            <li data-title="<%= item.title %>" data-category="<%= item.categoryName %>" data-tags="<%= item.tags.join('|') %>">
              <a class="post-link <%= !isNew && item.id === post.id ? 'active' : '' %>" href="/posts/<%= item.id %>">
                <span class="post-title"><%= item.title %></span>
                <span class="post-dot <%= item.status %>"></span>
              </a>
            </li>
          <% } %>
        </ul>
        <p class="side-hint">Ctrl/⌘ + 点击可在新标签打开</p>
      </section>
    </aside>

    <button type="button" class="left-reopen" id="toggle-left-open" aria-label="展开文章列表" title="展开文章列表">
      <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
        <path d="M7.5 4.5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="editor-canvas">
      <div class="doc-tabs" id="editor-tabs" role="tablist" aria-label="打开的文章"></div>

      <div class="editor-body">
        <label class="title-label" for="title">标题</label>
        <input id="title" name="title" class="title-input" value="<%= post.title %>" placeholder="写下一个标题..." required>

        <div class="editor-meta-line">
          <span class="mono"><%= isNew ? 'new post' : post.abbrlink %></span>
          <span class="dot-sep">·</span>
          <span><%= categories.find((c) => c.id === post.categoryId)?.name ?? '未分类' %></span>
          <span class="dot-sep">·</span>
          <span class="mono"><%= post.postDate %></span>
        </div>

        <input type="hidden" name="content_md" id="content_md" value="<%= post.contentMd %>">
        <div id="vditor" data-csrf="<%= csrfToken %>" data-post-id="<%= post.id ?? '' %>"></div>
      </div>
    </div>

    <aside class="editor-side">
      <section class="side-card">
        <div class="side-head">
          <h2 class="side-title">文章设置</h2>
          <button type="button" class="side-toggle" id="toggle-side" aria-expanded="true" aria-label="收起设置栏" title="收起设置栏">
            <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
              <path d="M7.5 4.5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        <div class="side-field">
          <label for="category_id">分类</label>
          <select id="category_id" name="category_id">
            <option value="">未分类</option>
            <% for (const category of categories) { %>
              <option value="<%= category.id %>" <%= post.categoryId === category.id ? 'selected' : '' %>><%= category.name %></option>
            <% } %>
          </select>
          <div class="category-create">
            <input id="new-category-name" type="text" placeholder="新建分类名称" maxlength="50" autocomplete="off" aria-label="新建分类名称">
            <button type="button" class="category-create-btn" id="create-category">新建</button>
          </div>
          <p class="field-hint" id="category-create-error" hidden></p>
        </div>

        <div class="side-field">
          <label for="tag-input">标签</label>
          <input type="hidden" name="tags" id="tags" value="<%= post.tagsText ?? post.tags.join(', ') %>">
          <div class="tag-editor" id="tag-editor">
            <div class="tag-chips" id="tag-chips"></div>
            <input type="text" id="tag-input" placeholder="输入后回车" autocomplete="off">
          </div>
        </div>

        <div class="side-field">
          <label for="post_date">日期</label>
          <input id="post_date" name="post_date" class="mono" value="<%= post.postDate ?? '' %>" placeholder="YYYY-MM-DD HH:mm:ss">
        </div>


        <div class="side-field">
          <label>发布状态</label>
          <div class="segmented" role="radiogroup" aria-label="发布状态">
            <label class="segment">
              <input type="radio" name="status" value="draft" <%= post.status === 'draft' ? 'checked' : '' %>>
              <span>草稿</span>
            </label>
            <label class="segment">
              <input type="radio" name="status" value="published" <%= post.status === 'published' ? 'checked' : '' %>>
              <span>已发布</span>
            </label>
          </div>
        </div>

        <div class="side-field side-field-inline">
          <label for="top_img_enabled">顶部图</label>
          <label class="switch">
            <input type="checkbox" id="top_img_enabled" <%= post.topImg !== 'false' ? 'checked' : '' %>>
            <span class="switch-track"></span>
          </label>
          <input type="hidden" id="top_img" name="top_img" value="<%= post.topImg ?? 'false' %>">
        </div>

        <div class="side-field">
          <label for="description">摘要</label>
          <textarea id="description" name="description" rows="3" placeholder="一句话介绍这篇文章"><%= post.description ?? '' %></textarea>
        </div>

        <% if (!isNew) { %>
          <div class="side-divider"></div>
          <p class="side-hint">删除后进入回收站，可在“回收站”文件夹恢复。</p>
          <button class="btn-danger-ghost" type="submit" form="delete-form">删除文章</button>
        <% } %>
      </section>

    </aside>

    <button type="button" class="side-reopen" id="toggle-side-open" aria-label="展开设置栏" title="展开设置栏">
      <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
        <path d="M12.5 4.5l-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</form>

<% if (!isNew) { %>
  <form id="delete-form" method="post" action="/posts/<%= post.id %>/delete" hidden>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  </form>
<% } %>

<script src="/static/vditor/dist/index.min.js"></script>
<script src="/static/editor.js?<%= Date.now() %>"></script>
<%- include('../partials/footer') %>
