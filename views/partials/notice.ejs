<% if (typeof notice !== 'undefined' && notice) { %>
  <p class="notice"><%= ({
    created: '已创建',
    saved: '已保存',
    deleted: '已移入回收站',
    restored: '已恢复',
    purged: '已彻底删除',
    published: '已发布',
    unpublished: '已取消发布'
  })[notice] || notice %></p>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <p class="error"><%= ({
    'category-in-use': '该分类下还有文章，无法删除',
    'tag-in-use': '该标签仍被文章使用，无法删除',
    duplicate: '名称已存在',
    invalid: '请检查输入内容',
    'not-found': '文章不存在'
  })[error] || error %></p>
<% } %>
