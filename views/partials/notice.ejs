<% if (typeof notice !== 'undefined' && notice) { %>
  <p class="notice" role="status" aria-live="polite"><%= ({
    created: '已创建',
    saved: '已保存',
    deleted: '已移入回收站',
    restored: '已恢复',
    purged: '已彻底删除',
    published: '已发布',
    unpublished: '已取消发布',
    pushed: '已发布到 GitHub'
  })[notice] || notice %></p>
  <script>
    (function () {
      var el = document.currentScript && document.currentScript.previousElementSibling;
      if (!el || !el.classList.contains('notice')) return;
      setTimeout(function () {
        el.classList.add('is-hiding');
        setTimeout(function () { el.remove(); }, 280);
      }, 3200);
    })();
  </script>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <p class="error"><%= ({
    'category-in-use': '该分类下还有文章，无法删除',
    'tag-in-use': '该标签仍被文章使用，无法删除',
    duplicate: '名称已存在',
    invalid: '请检查输入内容',
    'not-found': '文章不存在',
    busy: '发布正在进行中，请稍后重试',
    failed: '发布失败，请查看发布状态或服务器日志'
  })[error] || error %></p>
<% } %>
