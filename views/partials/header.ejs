<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' | ' : '' %>iHMOD Admin</title>
  <link rel="stylesheet" href="/static/admin.css">
<% if (typeof vditor !== 'undefined' && vditor) { %>
  <link rel="stylesheet" href="/static/vditor/dist/index.css">
<% } %>
</head>
<body>
<% if (typeof user !== 'undefined' && user) { %>
<nav class="nav">
  <a class="brand" href="/">iHMOD Admin</a>
  <div class="nav-links">
    <a href="/">仪表盘</a>
    <a href="/posts">文章</a>
    <a href="/categories">分类</a>
    <a href="/tags">标签</a>
    <a href="/media">媒体</a>
    <span class="who"><%= user.username %></span>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="link-button" type="submit">退出</button>
    </form>
  </div>
</nav>
<% } %>
<main class="container">
